{
  "name": "gaeludyr-cli",
  "version": "0.2.0",
  "description": "Unofficial CLI and MCP server for Gæludýr.is, an Icelandic pet-supply shop",
  "license": "MIT",
  "author": "Axel Paul Gunnarsson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axelpaul/gaeludyr-cli.git"
  },
  "homepage": "https://github.com/axelpaul/gaeludyr-cli#readme",
  "bugs": {
    "url": "https://github.com/axelpaul/gaeludyr-cli/issues"
  },
  "keywords": [
    "gaeludyr",
    "iceland",
    "pet-supplies",
    "cli",
    "mcp"
  ],
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "gaeludyr": "src/index.ts"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "serve": "bun src/index.ts serve",
    "build": "bun build --compile src/index.ts --outfile gaeludyr",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "format": "biome check --write src/",
    "test": "bun test",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/bun": "^1.3.12",
    "typescript": "^5.5.0"
  }
}
